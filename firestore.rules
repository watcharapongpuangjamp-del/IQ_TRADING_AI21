rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             data.executionMode is string && data.executionMode in ['SIMULATION', 'DEMO', 'LIVE'] &&
             data.simulationBalance is number && data.simulationBalance >= 0 && data.simulationBalance <= 10000000 &&
             (!('lastBackupAt' in data) || isValidTimestamp(data.lastBackupAt)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStrategyConfig(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.instrument is string && data.instrument.size() >= 3 && data.instrument.size() <= 20 &&
             data.timeframe is string && data.timeframe in ['1m', '5m', '15m'] &&
             data.tradeAmount is number && data.tradeAmount >= 1 && data.tradeAmount <= 100000 &&
             data.expirySeconds is int && data.expirySeconds >= 60 && data.expirySeconds <= 3600 &&
             data.rsiPeriod is int && data.rsiPeriod >= 2 && data.rsiPeriod <= 50 &&
             data.rsiOversold is int && data.rsiOversold >= 5 && data.rsiOversold <= 45 &&
             data.rsiOverbought is int && data.rsiOverbought >= 55 && data.rsiOverbought <= 95 &&
             data.emaFast is int && data.emaFast >= 2 && data.emaFast <= 50 &&
             data.emaSlow is int && data.emaSlow >= 5 && data.emaSlow <= 200 &&
             data.macdFast is int && data.macdFast >= 2 && data.macdFast <= 50 &&
             data.macdSlow is int && data.macdSlow >= 5 && data.macdSlow <= 100 &&
             data.macdSignal is int && data.macdSignal >= 2 && data.macdSignal <= 50 &&
             data.bbPeriod is int && data.bbPeriod >= 5 && data.bbPeriod <= 50 &&
             data.bbStdDev is number && data.bbStdDev >= 0.5 && data.bbStdDev <= 4.0 &&
             data.minConfidence is int && data.minConfidence >= 50 && data.minConfidence <= 99 &&
             data.active is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRiskPolicy(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.maxTradeAmount is number && data.maxTradeAmount >= 1 && data.maxTradeAmount <= 100000 &&
             data.maxDailyLoss is number && data.maxDailyLoss >= 1 && data.maxDailyLoss <= 1000000 &&
             data.maxConsecutiveLosses is int && data.maxConsecutiveLosses >= 1 && data.maxConsecutiveLosses <= 20 &&
             data.maxDailyTrades is int && data.maxDailyTrades >= 1 && data.maxDailyTrades <= 500 &&
             data.maxPortfolioExposure is number && data.maxPortfolioExposure >= 1 && data.maxPortfolioExposure <= 1000000 &&
             data.cooldownMinutes is int && data.cooldownMinutes >= 0 && data.cooldownMinutes <= 1440 &&
             data.emergencyStopped is bool &&
             data.autoTradeEnabled is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTradeRecord(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.instrument is string && data.instrument.size() >= 3 && data.instrument.size() <= 20 &&
             data.timeframe is string && data.timeframe in ['1m', '5m', '15m'] &&
             data.direction is string && data.direction in ['CALL', 'PUT'] &&
             data.mode is string && data.mode in ['SIMULATION', 'DEMO', 'LIVE'] &&
             data.amount is number && data.amount >= 1 && data.amount <= 100000 &&
             data.payoutRate is number && data.payoutRate >= 0.1 && data.payoutRate <= 2.0 &&
             data.entryPrice is number && data.entryPrice > 0 &&
             data.exitPrice is number && data.exitPrice >= 0 &&
             data.status is string && data.status in ['OPEN', 'WON', 'LOST', 'REJECTED', 'CANCELLED'] &&
             data.pnl is number && data.pnl >= -100000 && data.pnl <= 200000 &&
             data.strategyName is string && data.strategyName.size() >= 1 && data.strategyName.size() <= 80 &&
             data.confidenceScore is int && data.confidenceScore >= 0 && data.confidenceScore <= 100 &&
             data.calibratedProbability is number && data.calibratedProbability >= 0.0 && data.calibratedProbability <= 1.0 &&
             data.explanation is string && data.explanation.size() <= 500 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDailySummary(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.totalTrades is int && data.totalTrades >= 0 && data.totalTrades <= 10000 &&
             data.wins is int && data.wins >= 0 && data.wins <= 10000 &&
             data.losses is int && data.losses >= 0 && data.losses <= 10000 &&
             data.netPnl is number && data.netPnl >= -10000000 && data.netPnl <= 10000000 &&
             data.consecutiveLosses is int && data.consecutiveLosses >= 0 && data.consecutiveLosses <= 100 &&
             data.peakDrawdown is number && data.peakDrawdown >= 0 && data.peakDrawdown <= 10000000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'executionMode', 'simulationBalance', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'executionMode', 'simulationBalance', 'lastBackupAt', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'executionMode', 'simulationBalance', 'lastBackupAt', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /strategies/{strategyId} {
        allow get: if isOwner(userId) && isValidId(strategyId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(strategyId) &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'instrument', 'timeframe', 'tradeAmount', 'expirySeconds',
                           'rsiPeriod', 'rsiOversold', 'rsiOverbought', 'emaFast', 'emaSlow',
                           'macdFast', 'macdSlow', 'macdSignal', 'bbPeriod', 'bbStdDev',
                           'minConfidence', 'active', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'instrument', 'timeframe', 'tradeAmount', 'expirySeconds',
                           'rsiPeriod', 'rsiOversold', 'rsiOverbought', 'emaFast', 'emaSlow',
                           'macdFast', 'macdSlow', 'macdSignal', 'bbPeriod', 'bbStdDev',
                           'minConfidence', 'active', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidStrategyConfig(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(strategyId) &&
                         isValidStrategyConfig(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'instrument', 'timeframe', 'tradeAmount', 'expirySeconds',
                           'rsiPeriod', 'rsiOversold', 'rsiOverbought', 'emaFast', 'emaSlow',
                           'macdFast', 'macdSlow', 'macdSignal', 'bbPeriod', 'bbStdDev',
                           'minConfidence', 'active', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(strategyId);
      }

      match /riskPolicies/{policyId} {
        allow get: if isOwner(userId) && isValidId(policyId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(policyId) &&
                         incoming().keys().hasAll([
                           'userId', 'maxTradeAmount', 'maxDailyLoss', 'maxConsecutiveLosses',
                           'maxDailyTrades', 'maxPortfolioExposure', 'cooldownMinutes',
                           'emergencyStopped', 'autoTradeEnabled', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'maxTradeAmount', 'maxDailyLoss', 'maxConsecutiveLosses',
                           'maxDailyTrades', 'maxPortfolioExposure', 'cooldownMinutes',
                           'emergencyStopped', 'autoTradeEnabled', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidRiskPolicy(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(policyId) &&
                         isValidRiskPolicy(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'maxTradeAmount', 'maxDailyLoss', 'maxConsecutiveLosses',
                           'maxDailyTrades', 'maxPortfolioExposure', 'cooldownMinutes',
                           'emergencyStopped', 'autoTradeEnabled', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(policyId);
      }

      match /trades/{tradeId} {
        allow get: if isOwner(userId) && isValidId(tradeId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(tradeId) &&
                         incoming().keys().hasAll([
                           'userId', 'instrument', 'timeframe', 'direction', 'mode', 'amount',
                           'payoutRate', 'entryPrice', 'exitPrice', 'status', 'pnl', 'strategyName',
                           'confidenceScore', 'calibratedProbability', 'explanation', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'instrument', 'timeframe', 'direction', 'mode', 'amount',
                           'payoutRate', 'entryPrice', 'exitPrice', 'status', 'pnl', 'strategyName',
                           'confidenceScore', 'calibratedProbability', 'explanation', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidTradeRecord(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(tradeId) &&
                         isValidTradeRecord(incoming()) &&
                         existing().status == 'OPEN' &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'exitPrice', 'status', 'pnl', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(tradeId);
      }

      match /dailySummaries/{dateKey} {
        allow get: if isOwner(userId) && isValidId(dateKey);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(dateKey) &&
                         incoming().dateKey == dateKey &&
                         incoming().keys().hasAll([
                           'userId', 'dateKey', 'totalTrades', 'wins', 'losses',
                           'netPnl', 'consecutiveLosses', 'peakDrawdown', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'dateKey', 'totalTrades', 'wins', 'losses',
                           'netPnl', 'consecutiveLosses', 'peakDrawdown', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidDailySummary(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(dateKey) &&
                         isValidDailySummary(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'totalTrades', 'wins', 'losses', 'netPnl',
                           'consecutiveLosses', 'peakDrawdown', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(dateKey);
      }
    }
  }
}
