{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Trader account profile, active execution mode, and simulation balance.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "displayName": { "type": "string", "description": "Trader display name." },
        "email": { "type": "string", "description": "Optional email address." },
        "executionMode": { "type": "string", "enum": ["SIMULATION", "DEMO", "LIVE"] },
        "simulationBalance": { "type": "number", "description": "Simulated paper trading balance in USD." },
        "lastBackupAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last cloud backup." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on create." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update." }
      },
      "required": ["userId", "displayName", "executionMode", "simulationBalance", "createdAt", "updatedAt"]
    },
    "StrategyConfig": {
      "title": "StrategyConfig",
      "description": "Customizable technical analysis and signal threshold strategy configuration.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "instrument": { "type": "string" },
        "timeframe": { "type": "string", "enum": ["1m", "5m", "15m"] },
        "tradeAmount": { "type": "number" },
        "expirySeconds": { "type": "integer" },
        "rsiPeriod": { "type": "integer" },
        "rsiOversold": { "type": "integer" },
        "rsiOverbought": { "type": "integer" },
        "emaFast": { "type": "integer" },
        "emaSlow": { "type": "integer" },
        "macdFast": { "type": "integer" },
        "macdSlow": { "type": "integer" },
        "macdSignal": { "type": "integer" },
        "bbPeriod": { "type": "integer" },
        "bbStdDev": { "type": "number" },
        "minConfidence": { "type": "integer" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "name", "instrument", "timeframe", "tradeAmount", "expirySeconds",
        "rsiPeriod", "rsiOversold", "rsiOverbought", "emaFast", "emaSlow",
        "macdFast", "macdSlow", "macdSignal", "bbPeriod", "bbStdDev",
        "minConfidence", "active", "createdAt", "updatedAt"
      ]
    },
    "RiskPolicy": {
      "title": "RiskPolicy",
      "description": "Independent risk management limits and emergency stop guardrails.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "maxTradeAmount": { "type": "number" },
        "maxDailyLoss": { "type": "number" },
        "maxConsecutiveLosses": { "type": "integer" },
        "maxDailyTrades": { "type": "integer" },
        "maxPortfolioExposure": { "type": "number" },
        "cooldownMinutes": { "type": "integer" },
        "emergencyStopped": { "type": "boolean" },
        "autoTradeEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "maxTradeAmount", "maxDailyLoss", "maxConsecutiveLosses",
        "maxDailyTrades", "maxPortfolioExposure", "cooldownMinutes",
        "emergencyStopped", "autoTradeEnabled", "createdAt", "updatedAt"
      ]
    },
    "TradeRecord": {
      "title": "TradeRecord",
      "description": "Executed or simulated trade order record with signal attribution and P&L.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "instrument": { "type": "string" },
        "timeframe": { "type": "string", "enum": ["1m", "5m", "15m"] },
        "direction": { "type": "string", "enum": ["CALL", "PUT"] },
        "mode": { "type": "string", "enum": ["SIMULATION", "DEMO", "LIVE"] },
        "amount": { "type": "number" },
        "payoutRate": { "type": "number" },
        "entryPrice": { "type": "number" },
        "exitPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["OPEN", "WON", "LOST", "REJECTED", "CANCELLED"] },
        "pnl": { "type": "number" },
        "strategyName": { "type": "string" },
        "confidenceScore": { "type": "integer" },
        "calibratedProbability": { "type": "number" },
        "explanation": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "instrument", "timeframe", "direction", "mode", "amount",
        "payoutRate", "entryPrice", "exitPrice", "status", "pnl", "strategyName",
        "confidenceScore", "calibratedProbability", "explanation", "createdAt", "updatedAt"
      ]
    },
    "DailyPnLSummary": {
      "title": "DailyPnLSummary",
      "description": "Daily profit and loss aggregate for dashboard and risk tracking.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "dateKey": { "type": "string" },
        "totalTrades": { "type": "integer" },
        "wins": { "type": "integer" },
        "losses": { "type": "integer" },
        "netPnl": { "type": "number" },
        "consecutiveLosses": { "type": "integer" },
        "peakDrawdown": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "dateKey", "totalTrades", "wins", "losses",
        "netPnl", "consecutiveLosses", "peakDrawdown", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and execution balance isolated by userId."
    },
    "/users/{userId}/strategies/{strategyId}": {
      "schema": { "$ref": "#/entities/StrategyConfig" },
      "description": "User trading strategies backed up in cloud."
    },
    "/users/{userId}/riskPolicies/{policyId}": {
      "schema": { "$ref": "#/entities/RiskPolicy" },
      "description": "User risk management policies and emergency stop state."
    },
    "/users/{userId}/trades/{tradeId}": {
      "schema": { "$ref": "#/entities/TradeRecord" },
      "description": "Trade execution log and settlement outcomes."
    },
    "/users/{userId}/dailySummaries/{dateKey}": {
      "schema": { "$ref": "#/entities/DailyPnLSummary" },
      "description": "Daily P&L summary keyed by YYYY-MM-DD."
    }
  }
}
