# IQ Trading AI - Python FastAPI Backend Configuration
# Copy to .env and configure values securely. Never commit .env with real secrets.

APP_ENV=development
DATABASE_URL=sqlite:///./iq_trading.db
DEFAULT_EXECUTION_MODE=SIMULATION
ALLOW_LIVE_TRADING=false

# Set a strong random token in production for Bearer authentication
API_BEARER_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Telegram alerts from backend
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional external HTTP Broker Adapter (keep 'simulation' unless verified & authorized)
BROKER_ADAPTER=simulation
BROKER_BASE_URL=
BROKER_API_TOKEN=
BROKER_TIMEOUT_SECONDS=10.0
# IQ Option unofficial adapter (Practice-only; REAL is hard-locked)
# Set BROKER_ADAPTER=iqoption to enable the authenticated Practice login panel.
# Credentials are entered in the Android app, sent over HTTPS, held in backend memory only,
# and cleared when the session disconnects. Do not set them here or commit secrets.
IQOPTION_BALANCE_MODE=PRACTICE
